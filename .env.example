APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Progressive and named rate limits default off for local/development and on for testing/production.
# Override explicitly with true or false when needed.
PROGRESSIVE_RATE_LIMITING=
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Production: set SESSION_DRIVER, CACHE_STORE, QUEUE_CONNECTION, and RATE_LIMIT_CACHE_STORE to redis.
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=local-app-id
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1
REVERB_SCALING_ENABLED=false
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
NAVIGATION_API=
OPENROUTESERVICE_DIRECTIONS_URL=https://api.heigit.org/openrouteservice/v2/directions/driving-car
# Configure a licensed tile provider in production and restrict its public key to your domain.
# Use a separate development key for localhost; do not add localhost to the production key.
# MAP_TILE_URL=https://api.maptiler.com/maps/streets-v4/{z}/{x}/{y}.png?key={key}
# MAP_TILE_KEY=
# MAP_TILE_ATTRIBUTION="&copy; <a href='https://www.maptiler.com/copyright/'>MapTiler</a> &copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap contributors</a>"
MAP_TILE_MAX_ZOOM=19
FILESYSTEM_DISK=local
# CACHE_PREFIX=
# Production should use a shared atomic-lock-capable store such as Redis when available.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional role account overrides for php artisan db:seed. Set private passwords of at least 12 characters.
# SEED_ADMIN_NAME="Kalibo Admin"
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_NAME="Kalibo Staff"
# SEED_STAFF_EMAIL=staff@example.test
# SEED_STAFF_PASSWORD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional local MaxMind GeoLite2 databases. GeoIP is looked up only after a limit violation.
GEOIP_CITY_DATABASE=
GEOIP_ASN_DATABASE=
RATE_LIMIT_PRIMARY_COUNTRY=PH
RATE_LIMIT_COUNTRY_ALLOWLIST=
RATE_LIMIT_COUNTRY_BLOCKLIST=
