APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Progressive and named rate limits default off for local/development and on for testing/production.
# Override explicitly with true or false when needed.
PROGRESSIVE_RATE_LIMITING=
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=
# Production should use a shared atomic-lock-capable store such as Redis when available.
RATE_LIMIT_CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional role account overrides for php artisan db:seed. Set private passwords of at least 12 characters.
# SEED_ADMIN_NAME="Kalibo Admin"
# SEED_ADMIN_EMAIL=admin@example.test
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_NAME="Kalibo Staff"
# SEED_STAFF_EMAIL=staff@example.test
# SEED_STAFF_PASSWORD=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional local MaxMind GeoLite2 databases. GeoIP is looked up only after a limit violation.
GEOIP_CITY_DATABASE=
GEOIP_ASN_DATABASE=
RATE_LIMIT_PRIMARY_COUNTRY=PH
RATE_LIMIT_COUNTRY_ALLOWLIST=
RATE_LIMIT_COUNTRY_BLOCKLIST=
